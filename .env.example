# Copy to .env for local development. Never commit .env. `molo doctor`
# reports which of these resolve, never their values.

# --- local stack (infra/docker/compose.yaml) ---
DATABASE_URL=postgres://molo:molo@localhost:55432/molo
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=molo
S3_SECRET_ACCESS_KEY=molo-local-secret
S3_BUCKET_PUBLIC=molo-public
S3_BUCKET_PRIVATE=molo-private
SMTP_HOST=localhost
SMTP_PORT=1025

# --- auth ---
BETTER_AUTH_SECRET=change-me-32-bytes-minimum-for-local-only
BETTER_AUTH_URL=http://localhost:8787

# --- external, all optional locally; every command that uses one needs --live ---
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Encrypts secrets in the local .alchemy/ state; the GitHub secret holds the same value.
# ALCHEMY_PASSWORD=
# Shared secret of the molo-alchemy-state Worker that holds Alchemy's state; same value in CI.
# ALCHEMY_STATE_TOKEN=
# SENTRY_DSN=
# Deploy-only org:ci token for source maps; it cannot read issues.
# SENTRY_AUTH_TOKEN=
# Read token for molo sentry issues|issue: internal integration with org:read, project:read, event:read.
# SENTRY_READ_TOKEN=
# RESEND_API_KEY=
# FORVO_API_KEY=
# LINEAR_API_KEY=
# SLACK_WEBHOOK_URL=

# --- molo CLI (packages/cli) ---
# Signing secret for time-limited audio URLs (same value as apps/api/.dev.vars locally)
AUDIO_SIGNING_SECRET=change-me-too
API_URL=http://localhost:8787
# Per-environment targets used by --env preview|prod (never commit values)
# PREVIEW_DATABASE_URL=
# PREVIEW_API_URL=
# PlanetScale hands out ?sslmode=verify-full&sslrootcert=system; quote the value,
# the & breaks a plain shell source. packages/db strips what postgres.js cannot take.
# PROD_DATABASE_URL="postgresql://...?sslmode=verify-full&sslrootcert=system"
# PROD_API_URL=https://api.hellomolo.com
# R2 over its S3 endpoint, for the Bun-side audio worker (--env preview|prod)
# R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Bucket names default to molo-<public|private>-<env>; set these only for a per-PR preview stage.
# R2_BUCKET_PUBLIC=
# R2_BUCKET_PRIVATE=
# Cloudflare Queues pull consumer (molo audio worker, molo audio backlog). The
# token needs Queues Edit; the id is not secret (molo audio backlog --json prints it).
# QUEUE_AUDIO_PROCESS_ID=
# Sentry REST (molo sentry issues)
# SENTRY_ORG=
# SENTRY_PROJECT=
